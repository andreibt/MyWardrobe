{
  "expo": {
    "scheme": "acme",
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "name": "PolarNest",
    "slug": "PolarNest",
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.anonymous.mywardrobe"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.anonymous.mywardrobe",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow PolarNest to choose photos from your library for wardrobe and fridge items.",
        "NSPhotoLibraryAddUsageDescription": "Allow PolarNest to save updated item photos to your library when needed.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11359ff5-a1af-4016-9026-030b337877b8"
      }
    },
    "owner": "polaria-labs"
  }
}
