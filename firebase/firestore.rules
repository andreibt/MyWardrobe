rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /wardrobeItems/{itemId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow list: if request.auth != null
        && request.query != null
        && request.query.where('ownerId', '==', request.auth.uid);
    }

    match /wardrobeTags/{itemId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow list: if request.auth != null
        && request.query != null
        && request.query.where('ownerId', '==', request.auth.uid);
    }
    
     match /tryOnItems/{itemId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow list: if request.auth != null
        && request.query != null
        && request.query.where('ownerId', '==', request.auth.uid);
    }
    
     match /tryOnConfigs/{itemId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow list: if request.auth != null
        && request.query != null
        && request.query.where('ownerId', '==', request.auth.uid);
    }

    match /fridgeItems/{itemId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow list: if request.auth != null
        && request.query != null
        && request.query.where('ownerId', '==', request.auth.uid);
    }

    match /fridgeTags/{tagId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow list: if request.auth != null
        && request.query != null
        && request.query.where('ownerId', '==', request.auth.uid);
    }

    match /recipes/{recipeId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow list: if request.auth != null
        && request.query != null
        && request.query.where('ownerId', '==', request.auth.uid);
    }

    match /shoppingLists/{ownerId} {
      allow create: if request.auth != null
        && ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null
        && ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && ownerId == request.auth.uid
        && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && ownerId == request.auth.uid
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /wardrobeCalendarDays/{dayId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && dayId == request.auth.uid + '_' + request.resource.data.date;
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && dayId == request.auth.uid + '_' + request.resource.data.date;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
